#!/usr/bin/env python3
"""limitless-app-candidates [--json]: print the proposed work-app and feed-app lists as the reply to send back.

Reads the last seven days of app-in-foreground time from the phone's ActivityWatch DB (config aw_db) and the
desktop's (desktop_aw_url or desktop_aw_export), either is enough, and prints at most two lines:
"work apps: A, B" and "feed apps: C, D" (app_candidates.reply_line). Apps already in config flow_work_apps and
feed_apps are kept. --json prints the label, the reply and the lists with their foreground seconds.

It only suggests: it never writes config or any file (no bytecode either) and never sends. Unknown (no source
set or readable, too little app activity, no well-known work or feed app): no reply on stdout, the plain
reason on stderr, exit 0.
"""
import sys

sys.dont_write_bytecode = True
import argparse  # noqa: E402
import json  # noqa: E402
import time  # noqa: E402
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import app_candidates  # noqa: E402
from limitless.state_reader import StateReader, state_dir  # noqa: E402

KEYS = ("label", "reply", "work", "feed", "other", "sources", "max_n", "total_s", "why")


def main(argv=None) -> int:
    p = argparse.ArgumentParser(
        prog="limitless-app-candidates",
        description="Propose the work-app and feed-app lists from the last week of observed app time, as the "
                    "reply to send back. It only suggests: it never writes config or any file and never sends.")
    p.add_argument("--json", action="store_true", help="print the label, the reply and the lists as JSON")
    args = p.parse_args(argv)
    got = app_candidates.read_for(StateReader(state_dir()), time.time())
    reply = app_candidates.reply_line(got)
    if args.json:
        out = dict(got, reply=reply)
        print(json.dumps({k: out.get(k) for k in KEYS}, indent=2, ensure_ascii=False))
        return 0
    if reply:
        print(reply)
    else:
        print(f"limitless-app-candidates: {got['label']}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
