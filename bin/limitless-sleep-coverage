#!/usr/bin/env python3
"""limitless-sleep-coverage [--json]: on how many nights did the wearable record sleep? Read from the sleep file.

Prints the sleep coverage audit's words (limitless_sleep_coverage's label): wearable sleep on every, most, some or
few nights, the nights only the phone estimate covers and the nights with no sleep data, and whether the wearable
goal was met, e.g. "wearable sleep on few nights, phone estimate on most nights; wearable goal not met"; or
"unknown: <why>". --json prints the counts instead: wearable, phone-estimate-only, unknown and known nights, the
window, the share, the target, the goal and the demo rows left out. The state dir is $LIMITLESS_STATE, else
"state" in config.json; config sleep_file, sleep_coverage_days, sleep_coverage_target and mock_device_patterns
apply; nights are local to this machine's zone.
Read-only: it never writes a file, restarts anything or sends. Exit 0.
"""
import sys

sys.dont_write_bytecode = True
import argparse  # noqa: E402
import json  # noqa: E402
import time  # noqa: E402
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import tools  # noqa: E402
from limitless.state_reader import StateReader, state_dir  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(prog="limitless-sleep-coverage",
                                 description="Read-only: wearable sleep coverage per night from the sleep file.")
    ap.add_argument("--json", action="store_true", help="print the counts as JSON")
    a = ap.parse_args(argv[1:])
    reader, now = StateReader(state_dir()), time.time()
    res = tools.sleep_coverage(reader, now)
    words, reason = res["label"]["label"], res.get("reason")
    if a.json:
        got, _ = tools.sleep_coverage_audit(reader, now)
        out = {"label": words}
        if got is not None:
            out.update({k: got[k] for k in tools.SLEEP_COVERAGE_RAW_KEYS})
        if reason:
            out["reason"] = reason
        print(json.dumps(out, indent=1, sort_keys=True))
    else:
        print(f"{words}: {reason}" if reason else words)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
