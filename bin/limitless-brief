#!/usr/bin/env python3
"""limitless-brief: render + deliver the wake-up brief. Private, local-only.
build: write state/brief-latest.md from real state. send: build + deliver via kevin-push (Telegram).
show: print the latest file. Before delivery the text is finalized: card ids removed and the folded
'Asks waiting on you' digest (kevin-push asks-latest.json) added as one line, and "Saved last night: N
ideas" when bedtime capture saved any (bedtime.saved_last_night), and one overnight line when a work queue
is configured (overnight.landed_for: done and failed since the wind-down event, in count words), and one naps line
when phone Sleep mode changed yesterday (jobs_runner.brief_naps: words only, nothing when unknown), and one
"Yesterday's work" line from app activity (jobs_runner.brief_flow_ledger: words only, nothing when unknown),
and one "Not recording: ..." line when an input stopped recording (jobs_runner.brief_outage: said once per
outage; send records the outage's start and marks it told only after a real delivery; build only previews;
config input_outage, outage_ignore, outage_hints), and one "Work and feed app lists set from your reply." line
once after the apps ingest wrote the lists from a reply (jobs_runner.brief_apps_set: words only, never a name; send
marks that write told in apps-set.json only after a real delivery, so a later reply is told again; build only
previews; config apps_ingest "write"; the ask is left out of a brief that carries it), and, last, the app-lists ask
while both lists are unset
(jobs_runner.brief_apps_ask: a prompt and the pre-filled "work apps: / feed apps:" reply; send marks it told in
apps-ask.json only after a real delivery, so it is asked at most once in seven days; build only previews; config
apps_ask). Nothing here restarts anything.
send passes this wake's event key (jobs_runner.event_key, the key bin/limitless-jobs passes) to kevin-push
as $KEVIN_PUSH_ONCE, so one wake gets one brief whichever sender goes first. With no wake trigger (or
unreadable state) it sends as before, with no key; a KEVIN_PUSH_ONCE from outside is never passed on.
"""
import importlib.util
import json
import os
import sys
import time
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import bedtime, brief_post, jobs_runner, overnight  # noqa: E402
from limitless.state_reader import state_dir  # noqa: E402

spec = importlib.util.spec_from_file_location("limitless_loop", os.path.expanduser("~/.local/lib/limitless_loop.py"))
L = importlib.util.module_from_spec(spec)
spec.loader.exec_module(L)
ASKS = Path.home() / ".local/state/kevin-push/asks-latest.json"


def wake_key(now):
    """This wake's event key, or None (no wake trigger, or state that cannot be read: send as before)."""
    try:
        return jobs_runner.event_key(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return None


def saved_last_night(now):
    """Bedtime captures of the night that ended at this wake; 0 when state cannot be read."""
    try:
        return bedtime.saved_last_night(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return 0


def landed_overnight(now):
    """The overnight work queue's landed line; "" with no queue configured or unreadable state."""
    try:
        return overnight.landed_for(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return ""


def naps_yesterday(now):
    """Yesterday's naps in words (jobs_runner.brief_naps); "" when unknown or state cannot be read."""
    try:
        return jobs_runner.brief_naps(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return ""


def work_yesterday(now):
    """Yesterday's focus blocks, feed leaks and landed items in words (jobs_runner.brief_flow_ledger); "" when
    unknown or state cannot be read."""
    try:
        return jobs_runner.brief_flow_ledger(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return ""


def outage_line(now, write):
    """The input-outage line (jobs_runner.brief_outage); "" when none, off or state cannot be read. ``write``
    (send only) records each outage's start; build only previews."""
    try:
        return jobs_runner.brief_outage(state_dir(), now, write=write)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return ""


def outage_told(now):
    """After a delivered brief that carried the outage line: mark those outages told (said once)."""
    try:
        jobs_runner.brief_outage_told(state_dir(), now)
    except Exception:  # noqa: BLE001 - a failed mark must not fail the send
        pass


def apps_ask_text(now):
    """The app-lists ask (jobs_runner.brief_apps_ask); "" when off, not needed, told recently or unknown."""
    try:
        return jobs_runner.brief_apps_ask(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return ""


def apps_ask_told(now):
    """After a delivered brief that carried the app-lists ask: mark it told (once in seven days)."""
    try:
        jobs_runner.brief_apps_ask_told(state_dir(), now)
    except Exception:  # noqa: BLE001 - a failed mark must not fail the send
        pass


def apps_set_text(now):
    """The apps-set line (jobs_runner.brief_apps_set); "" when no write is untold, not write mode or unreadable."""
    try:
        return jobs_runner.brief_apps_set(state_dir(), now)
    except Exception:  # noqa: BLE001 - a broken state dir must not stop the brief
        return ""


def apps_set_told(now):
    """After a delivered brief that carried the apps-set line: mark that write told (said once per write)."""
    try:
        jobs_runner.brief_apps_set_told(state_dir(), now)
    except Exception:  # noqa: BLE001 - a failed mark must not fail the send
        pass


def notify(cfg, text, once=None):
    env = dict(os.environ, CIRCADIAN_CLASS=os.environ.get("CIRCADIAN_CLASS", "digest"))
    env.pop("KEVIN_PUSH_ONCE", None)          # the key is this wake's, never one left in the env
    if once:
        env["KEVIN_PUSH_ONCE"] = once
    d = L.deliver(cfg, "Wake-up brief", text, url="dash://notices", env=env)
    return (0 if str(d.get("shown", "")).startswith("telegram") else 1), d


def main(argv):
    cfg = L.load_config()
    cmd = argv[1] if len(argv) > 1 else "build"
    day = date.fromisoformat(argv[argv.index("--date") + 1]) if "--date" in argv else None
    out = L.build(cfg, day=day)
    now = time.time()
    sending = cmd in ("send", "--send")
    down = outage_line(now, write=sending)
    done = apps_set_text(now)
    ask = "" if done else apps_ask_text(now)      # the reply just landed: never ask for it in the same brief
    text = brief_post.finalize(out["notif"], brief_post.load_asks(ASKS), now, saved=saved_last_night(now),
                               overnight=landed_overnight(now), naps=naps_yesterday(now),
                               work=work_yesterday(now), outage=down, apps_set=done, apps_ask=ask)
    if sending:
        rc, msg = notify(cfg, text, once=wake_key(time.time()))
        if rc == 0 and down:
            outage_told(now)
        if rc == 0 and done:
            apps_set_told(now)
        if rc == 0 and ask:
            apps_ask_told(now)
        print(json.dumps({"path": out["path"], "notify_rc": rc, "notify": msg, "notif_text": text}, indent=1, default=str))
        return 0 if out else 2
    if cmd == "show":
        print(open(out["path"]).read())
        return 0
    print(json.dumps({"path": out["path"], "notif_text": text}, indent=1, default=str))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
