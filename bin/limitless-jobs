#!/usr/bin/env python3
"""limitless-jobs [--send | --ingest]: one pass over the event-triggered jobs; prints one line per job.

Without --send it is a dry run: verdicts only, nothing is pushed or written.
With --ingest (the timer's pass) the reply ingests (apps, ranked, sender; each by its own config mode) run for real,
exactly as --send runs them, and every other job is a plain dry run: kevin-push and limitless-brief are never called,
nothing is sent and no process is started. --ingest with --send is --send.
With --send, a deliver verdict goes out through `kevin-push limitless <title> <body> --once <job>:<event time>`
and --why <the verdict's reason> (its "Why now" line), with KEVIN_PUSH_STRICT=1 (any other sender for the same event should pass the same --once key), and the job is logged as sent (jobs-sent.jsonl in the state dir) only when
kevin-push reports a real Telegram delivery. kevin-push is $KEVIN_PUSH_BIN, else `kevin-push` on PATH.
The state dir is $LIMITLESS_STATE, else "state" in $LIMITLESS_CONFIG (~/.config/limitless/config.json).
Run it as often as you like (e.g. a systemd timer every few minutes): it polls for events and sends
at most once per trigger, never on a clock time.

Job owners: a job named in $LIMITLESS_EXTERNAL_JOBS (comma list) or config "external_jobs" has its own
sender; its line shows the verdict with "sent by its own sender", and nothing is pushed or logged for it.
Otherwise the wake brief is sent by `limitless-brief send` (the whole brief, same --once key), never the
one-line placeholder: $LIMITLESS_BRIEF_BIN, else `limitless-brief` on PATH, else this repo's
bin/limitless-brief. If it is missing or fails, the failure goes to stderr, nothing is sent and the job
holds until the next run.

NOOP export: with config "noop_export" set to "dry_run" or "write", one more line. After a sync whose runs.jsonl
row says it copied the NOOP database, --send runs the NOOP export once for that row, in-process (write mode
merges the sleep and pre-sleep heart-rate files), and records it in noop-export.json; it pushes nothing.

Apps ingest: with config "apps_ingest" set to "dry_run" or "write", one more line. Once after each new sync row in
runs.jsonl, --send reads the "work apps: ..." / "feed apps: ..." reply from the Hermes session DB (config
"hermes_db"; none set: skipped), in write mode writes apps.json, and records the action in apps-ingest.json; it
pushes nothing.

Outage recap: with config "outage_recap" set to "dry_run" or "write", one more line. After a push that kevin-push
delivered ended an outage in its log (config "push_log"), --send in write mode pushes one plain recap of what was
missed ("Pushes are back") through the same kevin-push call, with --once outage_recap:<first failed push time>, and
records it in outage-recap.json only when kevin-push reports a real delivery.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import jobs_runner  # noqa: E402
from limitless.state_reader import state_dir  # noqa: E402


def kevin_push(title, body, once=None, why=None):
    """What kevin-push reported: "telegram" only for a real delivery (exit 0 under STRICT). ``why`` (the
    verdict's reason) becomes the message's "Why now" line."""
    exe = os.environ.get("KEVIN_PUSH_BIN") or "kevin-push"
    env = dict(os.environ, KEVIN_PUSH_STRICT="1", CIRCADIAN_CLASS="decision")
    env.pop("KEVIN_PUSH_ONCE", None)          # the key is this event's, never one left in the env
    env.pop("KEVIN_PUSH_WHY", None)
    argv = [exe, "limitless", title, body] + (["--once", once] if once else []) + (["--why", why] if why else [])
    try:
        r = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        return f"kevin-push did not run ({type(e).__name__})"
    lines = [ln for ln in r.stdout.splitlines() if ln.startswith("kevin-push: ")]
    how = lines[-1][len("kevin-push: "):].strip() if lines else ""
    if r.returncode == 0 and how == jobs_runner.DELIVERED:
        return jobs_runner.DELIVERED
    return f"{how or 'no report'} (exit {r.returncode})"


def brief_bin():
    """limitless-brief: $LIMITLESS_BRIEF_BIN, else on PATH, else the one next to this script."""
    return (os.environ.get("LIMITLESS_BRIEF_BIN") or shutil.which("limitless-brief")
            or str(Path(__file__).resolve().parent / "limitless-brief"))


def limitless_brief():
    """`limitless-brief send`: "telegram" only when it reports a real delivery; else why not (logged)."""
    exe = brief_bin()
    env = dict(os.environ)
    env.pop("KEVIN_PUSH_ONCE", None)          # limitless-brief passes this wake's key itself
    try:
        r = subprocess.run([exe, "send"], env=env, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.SubprocessError) as e:
        how = f"limitless-brief did not run ({type(e).__name__})"
    else:
        try:
            out = json.loads(r.stdout)
        except ValueError:
            out = None
        note = out.get("notify") if isinstance(out, dict) else None
        shown = str(note.get("shown", "")) if isinstance(note, dict) else ""
        if r.returncode == 0 and isinstance(out, dict) and out.get("notify_rc") == 0 \
                and shown.startswith(jobs_runner.DELIVERED):
            return jobs_runner.DELIVERED
        how = f"limitless-brief: {shown or 'no report'} (exit {r.returncode})"
    print(f"limitless-jobs: wake brief not sent: {how}", file=sys.stderr)
    return how


def main(argv):
    args = argv[1:]
    if any(a not in ("--send", "--ingest") for a in args):
        print("usage: limitless-jobs [--send | --ingest]", file=sys.stderr)
        return 2
    send = "--send" in args
    rows = jobs_runner.run_once(state_dir(), time.time(), push=kevin_push if send else None, dry_run=not send,
                                brief=limitless_brief if send else None, ingest="--ingest" in args)
    for r in rows:
        print(f"{r['job']}: {r['action']}: {r['reason']}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
