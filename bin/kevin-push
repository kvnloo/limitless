#!/usr/bin/env python3
"""kevin-push [--once KEY] [--why REASON] <tag> <title> <body>: the ONE way agents reach Kevin's phone (Telegram).

Policy lives in limitless/send_gate.py: decision|critical (or the wake brief / back-from-nap) go to
Telegram; reports are log-only; 12 h dedupe; 6 sends/day; Sleep mode holds non-critical; the
'Asks waiting on you' digest is folded into one brief line (asks-latest.json); card ids are removed.
Every call is appended to ~/.local/state/kevin-push/log.jsonl.
Exit 0 unless args are missing. KEVIN_PUSH_STRICT=1: exit 3 when the message was not delivered,
so callers (brief-sent.json) can record 'sent' only on real delivery.
--once KEY (or $KEVIN_PUSH_ONCE) names the event the message is about, e.g. wake_brief:<event time>:
the first delivery claims the key and any other message with it in the next 12 h is dropped, whatever
its words, so two senders for one event send once. Only a real delivery claims a key; a held, log-only
or failed send does not, so a later retry can still go out.
Quiet (limitless/quiet.py, quiet.json in the state dir): while it holds, every message that would reach the
phone is dropped with "log (quiet: ...)", whatever its class (no urgent override) and never held for
later; with --once its key is claimed, so a retry for that event is dropped too. Missing or broken
quiet.json is on.
Every delivered message ends with one plain "Why now: ..." line (send_gate.outgoing): from --why REASON
(or $KEVIN_PUSH_WHY, e.g. the decision-window reason), else the event of an always-sent message, else the
decision window's reason for the class. Digits and card ids are left out of it; the dedupe key is the
message without it.
Every delivered message is then held to its shape (limitless/message_shape.py): the TLDR first line, at most
config message_max_lines lines (default 6) and message_max_line_chars characters a line (default 160), extra
middle lines folded into one "and N more lines in the plugin" line in words, the Reply and Why-now lines kept.
When anything was folded or cut, one content-free tier_audit row (counts only) is written.
A message Sleep mode holds goes to held.jsonl for the 'Back from nap' message once, not once per retry
(limitless/held.py): rows with the same --once key, else the same dedupe key (the message without its why
line), are one message; the newest copy replaces the older one, rows stay in order of their newest hold, and
the file is replaced whole (mode 0600). Every hold still writes its own log row ("held (sleep mode)"), so
the delivery audit sees each attempt. held.rows() is the reader: it lists each held message once.
A delivery runs `hermes -p <profile> send --to <target>` (limitless/push_sender.py): the profile is
$KEVIN_PUSH_PROFILE, else config push_profile, else "intake"; the target is $KEVIN_PUSH_TO, else config push_to,
else "telegram:kevin". limitless-doctor's "push sender" row says whether that profile can exist.
"""
import json
import os
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import held  # noqa: E402
from limitless import message_shape  # noqa: E402
from limitless import push_sender  # noqa: E402
from limitless import quiet as q  # noqa: E402
from limitless import send_gate as g  # noqa: E402
from limitless import tier_audit  # noqa: E402
from limitless.state_reader import config  # noqa: E402

ST = Path.home() / ".local/state/kevin-push"
LOG, SENT = ST / "log.jsonl", ST / "sent.json"
CONFIG = Path(os.environ.get("LIMITLESS_CONFIG", Path.home() / ".config/limitless/config.json"))


def state_dir():
    """Private state dir: $LIMITLESS_STATE, else config.json "state", else ~/.local/state/limitless."""
    if os.environ.get("LIMITLESS_STATE"):
        return Path(os.environ["LIMITLESS_STATE"])
    try:
        return Path(json.loads(CONFIG.read_text())["state"])
    except (OSError, ValueError, KeyError, TypeError):
        return Path.home() / ".local/state/limitless"


SLEEPMODE = Path(os.environ.get("LIMITLESS_SLEEPMODE", state_dir() / "sleepmode.jsonl"))
HOW = {"log": "log", "fold": "folded (brief line)", "hold": "held (sleep mode)",
       "duplicate": "log (duplicate)", "cap": "log (daily cap)", "drop": "log (dropped)"}
USAGE = "usage: kevin-push [--once KEY] [--why REASON] <tag> <title> <body>"


def split_opts(args, names=("--once", "--why")):
    """(positional args, {name: value}, ok): pulls `NAME VALUE` / `NAME=VALUE` for each name out of args."""
    rest, opts = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in names:
            if i + 1 >= len(args):
                return rest, opts, False
            opts[a], i = args[i + 1], i + 2
            continue
        name = next((n for n in names if a.startswith(n + "=")), None)
        if name:
            opts[name] = a[len(name) + 1:]
        else:
            rest.append(a)
        i += 1
    return rest, opts, True


def split_once(args):
    """(positional args, once key or None, ok): pulls `--once KEY` / `--once=KEY` out of args."""
    rest, opts, ok = split_opts(args, ("--once",))
    return rest, opts.get("--once"), ok


def asleep():
    """Phone Sleep mode, polled every 2 min by limitless-sync. Fails open (stale poll = awake)."""
    try:
        poll = json.loads(SLEEPMODE.with_name("sleepmode-poll.json").read_text())
        if not poll.get("ok") or time.time() - datetime.fromisoformat(poll["at"].replace("Z", "+00:00")).timestamp() > 600:
            return False
        return json.loads(SLEEPMODE.read_text().strip().splitlines()[-1]).get("on", False)
    except (OSError, ValueError, IndexError, KeyError):
        return False


def main(argv):
    args, opts, ok = split_opts(argv[1:])
    once, why = opts.get("--once"), opts.get("--why")
    if not ok or len(args) < 3:
        print(USAGE, file=sys.stderr)
        return 2
    tag, title, body = args[0], g.scrub(args[1]), g.scrub(args[2])
    once = g.scrub(once if once is not None else os.environ.get("KEVIN_PUSH_ONCE", "")).strip() or None
    cls = os.environ.get("CIRCADIAN_CLASS", "report")
    ST.mkdir(parents=True, exist_ok=True)
    now = time.time()
    sent = json.loads(SENT.read_text()) if SENT.exists() else []
    sent = [s for s in sent if now - s["t"] < 86400]
    quiet = q.check(state_dir(), now)
    verdict = g.decide(tag, title, body, cls, now, sent, asleep(), once_key=once, quiet=quiet)
    how = HOW.get(verdict, "log")
    if verdict == "drop" and g.quiet_reason(quiet) is not None:
        how = f"log ({g.quiet_reason(quiet)})"
        if once:
            sent.append(g.quiet_row(now, once))   # this event is dropped, not queued: a retry is dropped too
    elif verdict == "drop" and g.once_sent(sent, once, now):
        how = f"log ({g.ONCE_DROP})"
    if verdict == "fold":
        lines = [ln for ln in body.splitlines() if ln.strip()]
        (ST / "asks-latest.json").write_text(json.dumps({"at": int(now), "count": len(lines), "lines": lines[:20]}))
    elif verdict == "hold":
        # delivered inside the 'Back from nap' message; one row per message (once key, else dedupe key)
        held.add(ST / "held.jsonl", {"at": int(now), "tag": tag, "title": title, "body": body[:1000]}, once)
    elif verdict == "send":
        reason = why if why is not None else os.environ.get("KEVIN_PUSH_WHY", "")
        text = g.outgoing(body, g.why_line(reason if reason.strip() else g.why_reason(cls, title)))
        cfg = config()
        text, folded, cut = message_shape.fit(title, text, message_shape.limits(cfg))
        if folded or cut:
            tier_audit.record(tier_audit.shape_event(folded, cut, now))   # counts only, never the text
        with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as f:
            f.write(text)
        # the Hermes profile that owns the Telegram bot and the contact alias (not a chat id): env > config > default
        r = subprocess.run(["hermes", "-p", push_sender.profile(cfg), "send", "--to", push_sender.target(cfg),
                            "--subject", title,
                            "--file", f.name, "-q"], capture_output=True, text=True, timeout=60)
        os.unlink(f.name)
        how = "telegram" if r.returncode == 0 else f"log (telegram rc={r.returncode})"
        if r.returncode == 0:
            row = {"t": now, "k": g.key(title, body)}   # the key is the message without its why line
            if once:
                row["once"] = once        # claimed only on real delivery
            sent.append(row)
    SENT.write_text(json.dumps(sent))
    with open(LOG, "a") as f:
        shown = text if verdict == "send" else body
        f.write(json.dumps({"at": int(now), "tag": tag, "cls": cls, "title": title, "body": shown[:2000], "how": how}) + "\n")
    print(f"kevin-push: {how}")
    if os.environ.get("KEVIN_PUSH_STRICT") == "1" and how != "telegram":
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
