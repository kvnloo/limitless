#!/usr/bin/env python3
"""limitless-cron-spec [--json | --scripts <dir> | --check <jobs file> | --plan <jobs file> [--cli]]: the Hermes cron
job each plugin job would be.

Without --json: one line per job in words (its name in words, the decision window it waits for, how long until a held
occurrence is stale), or "skipped, sends nothing". With --json: a JSON list of keyword arguments for the host's
cron.jobs.create_job(...), one per sending job; the host's `hermes cron create` and cronjob tool do not take
window_class or stale_after_s (docs/decision-window.md#creating-the-jobs-on-a-patched-host).

With --scripts <dir>: writes each sending job's limitless-<job>.sh (cron_spec.script_body: it execs
`limitless-jobs --job <job> --send` from $LIMITLESS_PLUGIN_DIR) into <dir>, an existing directory, mode 0700, each
through a temp file and a rename; prints one line per file. It writes nowhere else.

With --check <jobs file>: reads the host's cron jobs file (read-only) and prints one line per sending job,
"<host job name>: <verdict>" (cron_spec.diff_records: ok, missing, differs: <fields in words>, paused on the host,
unreadable), plus any limitless- host job that is not a plugin job any more. Exit 0 when every job is ok, 1
otherwise, 2 for usage or a file it cannot read as a jobs file.

With --plan <jobs file>: reads the same file (read-only) and prints, as JSON (indent 1, sorted keys), the host
calls that would bring the records in step (cron_spec.update_plan): create_job with the payload for a missing job,
update_job with the record's id and only the differing fields for one that differs, and "none" with the reason for
what only the operator can sort out (an unreadable record, two records with one name, a limitless- job the plugin
no longer has). A paused job is never resumed and no job is ever deleted. It makes none of the calls. Exit 0 when
the plan is empty, 1 otherwise, 2 for usage or a file it cannot read as a jobs file.

With --plan <jobs file> --cli: the same plan as the host's own commands (cron_spec.plan_commands), one line per
step for the operator to review and paste: `hermes cron create ...` for a missing job, `hermes cron edit <job id>
...` with only the differing fields that have a flag, each argument shell-quoted. A field no `hermes cron` flag
sets (window, expiry) is a `# <job>: ... has no hermes cron flag` comment, never dropped; a "none" step is
`# <job>: <why>`. Never a delete, pause or resume line. Same exit codes as --plan; it runs none of them.

It never calls Hermes, never creates a job and never sends anything; without --scripts it writes no file.
"""
import json
import os
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import cron_spec  # noqa: E402

USAGE = ("usage: limitless-cron-spec [--json | --scripts <dir> | --check <jobs file> | --plan <jobs file> [--cli]]"
         "  (<dir> must exist)")


def write_script(path: Path, text: str) -> None:
    """``text`` to ``path`` through a 0700 temp file in the same directory and a rename."""
    fd, tmp = tempfile.mkstemp(prefix="." + path.name + ".", suffix=".tmp", dir=str(path.parent))
    try:
        os.fchmod(fd, 0o700)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, str(path))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_records(path: str):
    """The job records in the jobs file at ``path``, or None after one line on stderr. Read-only."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            text = f.read()
        return cron_spec.records_in(json.loads(text, strict=False))   # the host retries with strict=False too
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        print(f"limitless-cron-spec: cannot read {path} as a cron jobs file: {type(exc).__name__}", file=sys.stderr)
        return None


def check(path: str) -> int:
    """Print one verdict line per job for the jobs file at ``path``; 0 all ok, 1 not, 2 unreadable. Read-only."""
    records = read_records(path)
    if records is None:
        return 2
    verdicts = cron_spec.diff_records(records, cron_spec.payloads())
    for line in cron_spec.check_lines(verdicts):
        print(line)
    return 0 if all(v.ok for v in verdicts) else 1


def plan(path: str, cli: bool = False) -> int:
    """Print the update plan for the jobs file at ``path`` as JSON, or with ``cli`` as `hermes cron` lines; 0 empty,
    1 not, 2 unreadable. Read-only."""
    records = read_records(path)
    if records is None:
        return 2
    steps = cron_spec.update_plan(records, cron_spec.payloads())
    if cli:
        for line in cron_spec.plan_commands(steps):
            print(line)
    else:
        print(json.dumps(steps, indent=1, sort_keys=True))
    return 0 if not steps else 1


def main(argv):
    args = argv[1:]
    if len(args) == 3 and args[0] == "--plan" and args[2] == "--cli":
        return plan(args[1], cli=True)
    if args[:1] in (["--check"], ["--plan"]):
        if len(args) != 2:
            print(USAGE, file=sys.stderr)
            return 2
        return check(args[1]) if args[0] == "--check" else plan(args[1])
    if len(args) == 2 and args[0] == "--scripts":
        out = Path(args[1])
        if not out.is_dir():
            print(USAGE, file=sys.stderr)
            return 2
        for name, text in cron_spec.scripts().items():
            write_script(out / name, text)
            print(f"wrote {name}")
        return 0
    if args not in ([], ["--json"]):
        print(USAGE, file=sys.stderr)
        return 2
    if args:
        print(json.dumps(cron_spec.payloads(), indent=2))
    else:
        for line in cron_spec.plan_lines():
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
