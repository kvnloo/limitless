#!/usr/bin/env python3
"""limitless-scorecard [path]: print the weekly review's north-star block from the hand-kept scorecard table.

The path is the argument, else $LIMITLESS_SCORECARD, else "scorecard" in config.json. Read-only: it never
writes a file (no bytecode either) and never sends. No table or no configured path: exit 0, no output.
An unreadable file: exit 1 with a reason on stderr that does not echo the path.
"""
import sys

sys.dont_write_bytecode = True
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import scorecard  # noqa: E402


def main(argv):
    path = Path(argv[1]) if len(argv) > 1 else scorecard.path()
    if path is None:
        return 0
    try:
        text = path.read_text(errors="replace")
    except OSError:
        print("limitless-scorecard: no scorecard file at that path", file=sys.stderr)
        return 1
    block = scorecard.weekly_block(scorecard.summary(scorecard.parse(text)))
    if block:
        print(block)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
