#!/usr/bin/env python3
"""limitless-scorecard [path]: print the weekly review's north-star block from the hand-kept scorecard table.

The path is the argument, else $LIMITLESS_SCORECARD, else "scorecard" in config.json. The block's first line is
the self-reported counts line. When the state dir exists, it goes on with what code measured for rows one to
eight and ten ("Measured: loop uptime: ...", "Measured: delivery: ...", "Measured: habit loop: ...", "Measured:
evidence loop: ...", "Measured: foundation: ...", "Measured: flow: ...", "Measured: privacy: ...", "Measured:
integrated: ...", "Measured: top items: ...") and a note when a green row's measurement says not met, inside the
five lines; the rest fold into one line (scorecard.measured_lines).
Read-only: it never writes a file (no bytecode either) and never sends. No table or no configured path: exit 0, no output.
An unreadable file: exit 1 with a reason on stderr that does not echo the path.
"""
import sys

sys.dont_write_bytecode = True
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import time  # noqa: E402

from limitless import scorecard  # noqa: E402
from limitless.state_reader import config, state_dir  # noqa: E402


def _measured(rows):
    """The measured lines for the block, or [] when there is no state dir to measure."""
    st = state_dir()
    if not st.is_dir():
        return []
    return scorecard.measured_lines(rows, scorecard.measured(st, config(), time.time()))


def main(argv):
    path = Path(argv[1]) if len(argv) > 1 else scorecard.path()
    if path is None:
        return 0
    try:
        text = path.read_text(errors="replace")
    except OSError:
        print("limitless-scorecard: no scorecard file at that path", file=sys.stderr)
        return 1
    rows = scorecard.parse(text)
    block = scorecard.weekly_block(scorecard.summary(rows), _measured(rows))
    if block:
        print(block)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
