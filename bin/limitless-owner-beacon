#!/usr/bin/env python3
"""limitless-owner-beacon write --out PATH [--dbs a:b] [--db-glob PATTERN ...]: write this machine's "last seen" beacon.

For a machine whose Hermes session store the plugin host cannot open. It reads the owner session DBs here
(--dbs, os.pathsep-separated, and every match of each absolute --db-glob pattern, expanded on every run,
sorted, each path once; else $LIMITLESS_OWNER_DBS or config "owner_dbs") with the same read-only
query as limitless/owner_messages.py and writes only the newest user-message time:

    {"at": "<ISO 8601, UTC>", "v": 1}

No content, no counts, no source or session names. The file is written atomically (a temp file in the
same directory, then rename) with mode 0600. Copying it to the plugin host is up to the operator (see
docs/owner-beacon.md); there it is listed in $LIMITLESS_OWNER_BEACONS or config "owner_beacons".

When the newest time equals the one in a valid beacon already at --out, the file is left as it is (same
bytes, same mtime) and one line says it is unchanged, so a copy step on a schedule only moves a changed file.

Exit 0 when the beacon was written or left unchanged, and also when there is nothing to write (no DB configured, no DB
readable, no message from the person): then nothing is written, an old beacon is left as it is, and one
line says why. Exit 1 and one line on stderr when the file cannot be written; exit 2 and a usage line for
bad arguments, or one "refused" line for a relative --db-glob pattern or one with a newline. It never sends and never prints a traceback.

limitless-owner-beacon schedule --print --kind launchd|systemd --out PATH --every MINUTES
[--copy-to USER@HOST:PATH] [--db PATH ...] [--db-glob PATTERN ...] [--label LABEL] prints the job (a launchd plist, or a systemd
user .service and .timer) that runs the writer every MINUTES and then, with --copy-to,
`scp -q -p -o BatchMode=yes` of the beacon to the plugin host (limitless/beacon_schedule.py). It only prints: it never writes,
loads, enables or runs anything. Every host-specific value comes from the arguments. Each --db-glob pattern is
passed to the writer as given, not expanded, so a store added later is read without printing the job again.
"""
import glob
import json
import os
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import beacon_schedule, owner_messages  # noqa: E402
from limitless.state_reader import OWNER_DBS_CONFIG, OWNER_DBS_ENV, StateReader, state_dir  # noqa: E402

USAGE = ("usage: limitless-owner-beacon write --out PATH [--dbs PATH" + os.pathsep + "PATH...] "
         "[--db-glob PATTERN ...]")
SCHEDULE_USAGE = ("       limitless-owner-beacon schedule --print --kind launchd|systemd --out PATH --every MINUTES "
                  "[--copy-to USER@HOST:PATH] [--db PATH ...] [--db-glob PATTERN ...] [--label LABEL]")
HELP = (USAGE + "\n" + SCHEDULE_USAGE + "\n\n"
        "schedule --print prints a launchd plist or systemd user units that run the writer every MINUTES and then,\n"
        "with --copy-to, scp -q -p the beacon there. It only prints: it never writes, loads, enables or runs anything.\n"
        "Every host-specific value comes from the arguments; review the text, then install it yourself.")
NAME = "limitless-owner-beacon"
SCHEDULE_FLAGS = ("--kind", "--out", "--every", "--copy-to", "--label")


def parse(args):
    """{"out", "dbs"?, "db-glob": [...]} or None for bad arguments."""
    if not args or args[0] != "write":
        return None
    got, globs, rest = {}, [], list(args[1:])
    while rest:
        flag = rest.pop(0)
        if flag not in ("--out", "--dbs", "--db-glob") or not rest or not rest[0]:
            return None
        value = rest.pop(0)
        if flag == "--db-glob":
            globs.append(value)
        elif flag[2:] in got:
            return None
        else:
            got[flag[2:]] = value
    if "out" not in got:
        return None
    got["db-glob"] = globs
    return got


def parse_schedule(args):
    """{"kind", "out", "every", "copy-to"?, "label"?, "db": [...], "db-glob": [...]} or None for bad arguments."""
    if not args or args[0] != "schedule":
        return None
    got, dbs, globs, printing, rest = {}, [], [], False, list(args[1:])
    while rest:
        flag = rest.pop(0)
        if flag == "--print" and not printing:
            printing = True
            continue
        if flag not in SCHEDULE_FLAGS + ("--db", "--db-glob") or not rest or not rest[0]:
            return None
        value = rest.pop(0)
        if flag == "--db":
            dbs.append(value)
        elif flag == "--db-glob":
            globs.append(value)
        elif flag[2:] in got:
            return None
        else:
            got[flag[2:]] = value
    if not printing or not {"kind", "out", "every"} <= set(got) or got["kind"] not in beacon_schedule.KINDS:
        return None
    got["db"], got["db-glob"] = dbs, globs
    return got


def schedule(opts) -> int:
    values = [v for k, v in opts.items() if k not in ("db", "db-glob")] + opts["db"] + opts["db-glob"]
    why = beacon_schedule.refusal(values, opts["every"], opts["out"], opts.get("copy-to"), opts["db"],
                                  opts.get("label"), opts["db-glob"])
    if why:
        print(f"{NAME}: refused: {why}", file=sys.stderr)
        return 2
    every = opts["every"]
    print(beacon_schedule.render(opts["kind"], sys.executable, str(Path(__file__).resolve()), opts["out"],
                                 int(every), copy_to=opts.get("copy-to"), dbs=opts["db"], db_globs=opts["db-glob"],
                                 label=opts.get("label", beacon_schedule.DEFAULT_LABEL)), end="")
    return 0


def db_paths(flag, patterns=()):
    """The DBs to read: --dbs in order, then the sorted matches of each --db-glob pattern, expanded now (so a
    store added since the job was printed is read), each path once; else the configured owner_dbs. None when
    there are none, also when every pattern matched nothing."""
    if flag is None and not patterns:
        return StateReader(state_dir()).owner_db_paths()
    paths = [Path(p).expanduser() for p in (flag or "").split(os.pathsep) if p.strip()]
    for pattern in patterns:
        paths += [Path(p) for p in sorted(glob.glob(pattern))]
    once = []
    for p in paths:
        if p not in once:
            once.append(p)
    return once or None


def write_atomic(out: Path, body: str) -> None:
    """Write ``body`` to ``out`` through a 0600 temp file in the same directory and a rename."""
    fd, tmp = tempfile.mkstemp(dir=str(out.parent), prefix="." + out.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(body)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, str(out))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def current_time(out: Path):
    """Epoch seconds of the valid beacon already at ``out``, else None (absent, unreadable, too large, or not
    ``{"at": ISO with offset, "v": 1}``)."""
    try:
        if not out.is_file():
            return None
        with open(out, "rb") as f:
            raw = f.read(owner_messages.BEACON_MAX_BYTES + 1)
        if len(raw) > owner_messages.BEACON_MAX_BYTES:
            return None
        return owner_messages.beacon_time(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, ValueError, OverflowError):
        return None


def write(out: Path, dbs, now: float) -> int:
    if dbs is None:
        print(f"{NAME}: nothing written: no owner session DBs (--dbs, --db-glob, {OWNER_DBS_ENV} or "
              f"\"{OWNER_DBS_CONFIG}\" in config.json)")
        return 0
    got = owner_messages.newest_user_message(dbs, now)
    if got["at"] is None:
        why = ("no message from the person in the owner session DBs" if got["sources_read"]
               else "the owner session DBs could not be read")
        print(f"{NAME}: nothing written: {why}")
        return 0
    body = json.dumps({"at": got["at"], "v": owner_messages.BEACON_V}) + "\n"
    if current_time(out) == owner_messages.beacon_time(body):
        print(f"{NAME}: beacon unchanged: the newest time is the one already at --out")
        return 0
    try:
        write_atomic(out, body)
    except OSError as e:
        print(f"{NAME}: could not write the beacon: {e.strerror or type(e).__name__}", file=sys.stderr)
        return 1
    print(f"{NAME}: beacon written")
    return 0


def main(argv) -> int:
    args = argv[1:]
    if args in (["-h"], ["--help"], ["schedule", "-h"], ["schedule", "--help"]):
        print(HELP)
        return 0
    if args[:1] == ["schedule"]:
        opts = parse_schedule(args)
        if opts is None:
            print("usage: " + SCHEDULE_USAGE.strip(), file=sys.stderr)
            return 2
        return schedule(opts)
    opts = parse(args)
    if opts is None:
        print(USAGE, file=sys.stderr)
        return 2
    why = beacon_schedule.db_glob_refusal(opts["db-glob"])
    if why:
        print(f"{NAME}: refused: {why}", file=sys.stderr)
        return 2
    try:
        return write(Path(opts["out"]).expanduser(), db_paths(opts.get("dbs"), opts["db-glob"]), time.time())
    except Exception as e:  # noqa: BLE001 - a broken config or store is one line, never a traceback
        print(f"{NAME}: could not write the beacon: {type(e).__name__}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
