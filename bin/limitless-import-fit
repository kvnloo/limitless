#!/usr/bin/env python3
"""limitless-import-fit [--write] [--json] <file.fit>...: CAROL bike FIT ride exports into the rides file.

Each file is one ride (the CAROL web dashboard's "Download .FIT"). Dry run by default: one line per file,
"<name>: would add one ride" or the reason in words ("not a bike ride", "the FIT file is cut short", ...),
then the total ("would add two rides"). With --write it appends the new rows to the configured rides file
(config "rides_file", a relative path is in the state dir) and says "added two rides". A ride whose start
instant is already there from this importer is "already in the rides file" and is not appended again.
Digit-free except --json, which prints the whole result (durations included) as JSON.

Only the ride summary is read: power, heart rate and every other sample stay unread in the file. It never
reads the network, deletes or rewrites anything (append only, mode 0600), and never sends. Exit 2 on a
usage error, 1 when --write cannot write (no rides file set, or its folder is missing), else 0.
For a folder of exports imported by itself once per sync run, see config "fit_drop_dir" / "fit_ingest"
(limitless/fit_ingest_job.py, docs/carol-fit-import.md "Drop folder").
"""
import sys

sys.dont_write_bytecode = True
import argparse  # noqa: E402
import json  # noqa: E402
from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from limitless import fit_ride  # noqa: E402
from limitless.state_reader import StateReader, state_dir  # noqa: E402


def main(argv):
    ap = argparse.ArgumentParser(prog="limitless-import-fit",
                                 description="Add CAROL bike FIT ride exports to the rides file (dry run by default).")
    ap.add_argument("files", nargs="+", metavar="file.fit", help="one FIT file per ride")
    ap.add_argument("--write", action="store_true", help="append for real (default: dry run)")
    ap.add_argument("--json", action="store_true", help="print the whole result as JSON (numbers included)")
    a = ap.parse_args(argv[1:])
    rides_file = StateReader(state_dir()).rides_file()
    out = fit_ride.run(a.files, rides_file, write=a.write)
    if a.json:
        print(json.dumps(out, indent=2, sort_keys=True))
    else:
        for line in fit_ride.words(out, a.write):
            print(line)
    return 1 if out["why"] else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
